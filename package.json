{
  "name": "dsh-vs-sidebar",
  "displayName": "DeepSeek Harness Sidebar (DSH)",
  "description": "Embeds the local DeepSeek Harness (DSH) web UI into the VS Code auxiliary sidebar (the right-hand bar alongside Copilot Chat).",
  "version": "0.2.1",
  "publisher": "Xizhi1024",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xizhi1024/dsh-vs-sidebar.git"
  },
  "homepage": "https://github.com/Xizhi1024/dsh-vs-sidebar#readme",
  "bugs": {
    "url": "https://github.com/Xizhi1024/dsh-vs-sidebar/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek harness",
    "dsh",
    "ai agent",
    "coding agent",
    "sidebar",
    "webview"
  ],
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#0e639c",
    "theme": "dark"
  },
  "icon": "media/dsh.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:dsh.webview",
    "onCommand:dsh.openInBrowser",
    "onCommand:dsh.restartServer",
    "onCommand:dsh.focusSidebar"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "本扩展会启动本地 dsh web 进程并以工作区为 cwd 操作文件，不受信任的工作区中禁用"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "需要 dsh CLI 与真实文件系统，虚拟工作区不可用"
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dsh-sidebar",
          "title": "DeepSeek Harness (DSH)",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh-sidebar": [
        {
          "type": "webview",
          "id": "dsh.webview",
          "name": "DeepSeek Harness (DSH)"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openInBrowser",
        "title": "Open DSH in Browser",
        "category": "DeepSeek Harness"
      },
      {
        "command": "dsh.restartServer",
        "title": "Restart DSH Server",
        "category": "DeepSeek Harness"
      },
      {
        "command": "dsh.focusSidebar",
        "title": "Focus DSH Sidebar",
        "category": "DeepSeek Harness",
        "icon": "media/dsh.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dsh.focusSidebar",
          "group": "navigation@100",
          "when": "resourceScheme == file || resourceScheme == untitled"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness Sidebar (DSH)",
      "properties": {
        "dsh.port": {
          "type": "number",
          "default": 3080,
          "description": "DSH web 服务端口"
        },
        "dsh.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "DSH web 服务主机"
        },
        "dsh.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "无运行实例时自动启动 dsh web"
        }
      }
    }
  }
}
